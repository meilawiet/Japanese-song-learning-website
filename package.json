{
  "name": "uta-japanese-song-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lyrics:sync": "node scripts/sync-lyrics.mjs",
    "api": "server\\.venv\\Scripts\\python.exe -m uvicorn app:app --app-dir server --reload",
    "web": "vite",
    "dev": "npm run lyrics:sync && concurrently --kill-others-on-fail -n api,web \"npm run api\" \"npm run web\"",
    "build": "npm run lyrics:sync && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
