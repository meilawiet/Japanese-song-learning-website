{
  "name": "uta-japanese-song-learning",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "lyrics:sync": "node scripts/sync-lyrics.mjs",
    "api": "server\\.venv\\Scripts\\python.exe -m uvicorn app:app --app-dir server",
    "web": "vite",
    "dev": "npm run lyrics:sync && concurrently --kill-others-on-fail -n api,web \"npm run api\" \"npm run web\"",
    "build": "npm run lyrics:sync && vite build",
    "test:backup": "node --test tests/learningBackup.test.mjs",
    "test:lyrics": "node --test tests/lrcEncoding.test.mjs tests/learningIdentity.test.mjs",
    "test:readings": "node --test tests/readingDisplay.test.mjs tests/readingComponents.test.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "desktop:dev": "node node_modules/vite/bin/vite.js build --config vite.desktop.config.js && electron .",
    "desktop:build": "node scripts/build-desktop.mjs",
    "windows:package": "npm run desktop:build && node scripts/package-windows.mjs && server\\.venv\\Scripts\\python.exe -B scripts\\archive-windows.py",
    "test:desktop": "node tests/desktop.smoke.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@faanau/kuromoji": "^0.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "44.5.1",
    "playwright": "1.58.0",
    "rcedit": "5.0.2",
    "vite": "^7.1.7"
  },
  "description": "UTA Windows app for learning Japanese with song lyrics",
  "main": "desktop/main.cjs"
}
